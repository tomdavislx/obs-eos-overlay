{
  "name": "eos-obs-bridge",
  "version": "0.1.5",
  "description": "Real-time Eos lighting console cue overlay for OBS Studio",
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:tcp": "node test-tcp.js",
    "test:connection": "node test-connection.js",
    "start": "npm run build && node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "build:release": "npm run build && mkdir -p release && pkg dist/index.js --targets node20-macos-arm64 --output release/eos-obs-bridge-macos-arm64 && pkg dist/index.js --targets node20-macos-x64 --output release/eos-obs-bridge-macos-x64",
    "legacy": "node legacy/server.js"
  },
  "pkg": {
    "scripts": "dist/**/*.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "eos-console": "^0.3.1",
    "obs-websocket-js": "^5.0.8",
    "osc": "^2.4.5",
    "ws": "^8.18.3",
    "xstate": "^5.21.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.19.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
